      ]
    },
    {
      "id": "note5",
      "layer_id": "layer5",
      "title": "执行循环与治理",
      "items": [
        "队列、任务执行器和 Agent（智能体）组织模型及工具循环。",
        "工具参数校验、Guard（守卫）、Policy（策略授权）与 Approval（审批）职责分开。",
        "事件和 Receipt（凭证）保留执行依据；拒绝、等待与成功分别记录。",
        "Knowledge（知识检索）默认精确关键词；MCP（外部工具协议）先发现登记，再经治理执行。"
      ],
      "boundary": "assemble_real_engine（演示装配入口）与生产 build_runner_components（运行组件装配）不能混为一条必经链。",
      "sources": [
